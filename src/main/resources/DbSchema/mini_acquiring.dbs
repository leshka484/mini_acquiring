<project name="mini_acquiring" database="PostgreSQL" id="a1911e68-0ca9-4570-9bde-9a70c3486560" >
	<schema name="core" >
		<table name="commission" prior="commiss" >
			<column name="id" type="bigint" mandatory="y" >
				<identity><![CDATA[GENERATED BY DEFAULT AS IDENTITY]]></identity>
			</column>
			<column name="processed_at" type="timestamp" mandatory="y" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
			</column>
