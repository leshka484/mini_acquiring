<project name="mini_acquiring" database="PostgreSQL" id="a1911e68-0ca9-4570-9bde-9a70c3486560" >
	<schema name="commission" >
		<table name="commission_type" prior="commission_ty" >
			<column name="id" type="bigint" mandatory="y" />
			<column name="type" type="varchar" length="255" mandatory="y" />
			<index name="pk_commission_type" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
		</table>
	</schema>
	<schema name="core" >
		<table name="commission" prior="commiss" >
			<column name="id" type="bigint" mandatory="y" />
			<column name="processed_at" type="timestamp" mandatory="y" />
			<column name="total_commission" type="numeric" length="38" decimal="2" mandatory="y" />
