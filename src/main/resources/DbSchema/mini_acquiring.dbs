			<column name="created_at" type="timestamp" mandatory="y" />
			<column name="parent_id" type="bigint" />
			<column name="processed_at" type="timestamp" />
			<column name="sum" type="numeric" length="38" decimal="2" mandatory="y" />
			<column name="merchant_id" type="bigint" mandatory="y" />
			<column name="status_id" type="bigint" mandatory="y" />
			<column name="operation_type_id" type="bigint" mandatory="y" />
			<index name="pk_operati" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="idx_operation_merchant_id" unique="NORMAL" >
				<column name="merchant_id" />
			</index>
			<index name="idx_operation_status_id" unique="NORMAL" >
