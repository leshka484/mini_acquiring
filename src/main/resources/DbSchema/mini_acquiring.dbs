			</index>
			<fk name="fk_commission_merchant" to_schema="core" to_table="merchant" >
				<fk_column name="operation_id" pk="id" />
			</fk>
		</table>
		<table name="merchant" prior="mercha" >
			<column name="id" type="bigint" mandatory="y" />
